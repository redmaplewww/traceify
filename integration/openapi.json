{
  "openapi": "3.1.0",
  "info": {
    "title": "Traceify local editor API",
    "version": "2026-11-09-modules"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8768"
    }
  ],
  "paths": {
    "/api/workspace": {
      "get": {
        "operationId": "getWorkspace",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedWorkspace"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveWorkspace",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedWorkspace"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Expected version differs from the current version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveRequest"
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "operationId": "getSettings",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSettings"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "setSettings",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSettings"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsRequest"
              }
            }
          }
        }
      }
    },
    "/api/assist": {
      "post": {
        "operationId": "assist",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistRequest"
              }
            }
          }
        }
      }
    },
    "/demo.json": {
      "get": {
        "operationId": "getDemoWorkspace",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SourceRef": {
        "type": "object",
        "required": [
          "source_id",
          "locator",
          "excerpt"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "overview": {
            "type": "string"
          },
          "granularity": {
            "type": "string"
          }
        }
      },
      "Node": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "kind": {
            "enum": [
              "concept",
              "claim",
              "entity",
              "section",
              "evidence",
              "other"
            ]
          },
          "summary": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            }
          },
          "status": {
            "type": "string"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "Edge": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "relation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "relation_basis": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            }
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Group": {
        "type": "object",
        "required": [
          "id",
          "label",
          "node_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "basis": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": [
          "source",
          "graph"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "schema_version": {
            "const": 2
          },
          "source": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "content_hash": {
                "type": "string"
              },
              "segments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "tag": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "graph": {
            "type": "object",
            "required": [
              "nodes",
              "edges"
            ],
            "properties": {
              "nodes": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "$ref": "#/components/schemas/Node"
                }
              },
              "edges": {
                "type": "array",
                "maxItems": 2000,
                "items": {
                  "$ref": "#/components/schemas/Edge"
                }
              },
              "groups": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "$ref": "#/components/schemas/Group"
                }
              }
            }
          },
          "layout": {
            "type": "object"
          },
          "mappings": {
            "type": "array"
          },
          "outline": {
            "type": "array"
          },
          "evidence_chains": {
            "type": "array"
          },
          "pending_suggestions": {
            "type": "array"
          },
          "sync": {
            "type": "object"
          }
        }
      },
      "SavedWorkspace": {
        "type": "object",
        "required": [
          "version",
          "workspace"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "workspace": {
            "$ref": "#/components/schemas/Workspace"
          }
        }
      },
      "SaveRequest": {
        "type": "object",
        "required": [
          "expected_version",
          "workspace"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "workspace": {
            "$ref": "#/components/schemas/Workspace"
          }
        }
      },
      "PublicSettings": {
        "type": "object",
        "required": [
          "base_url",
          "model",
          "has_key",
          "configured"
        ],
        "properties": {
          "base_url": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "has_key": {
            "type": "boolean"
          },
          "configured": {
            "type": "boolean"
          }
        }
      },
      "SettingsRequest": {
        "type": "object",
        "properties": {
          "base_url": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "api_key": {
            "type": "string",
            "writeOnly": true
          },
          "clear_key": {
            "type": "boolean"
          }
        }
      },
      "AssistRequest": {
        "type": "object",
        "required": [
          "workspace",
          "target",
          "mode"
        ],
        "properties": {
          "workspace": {
            "$ref": "#/components/schemas/Workspace"
          },
          "mode": {
            "enum": [
              "source",
              "model"
            ]
          },
          "target": {
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "node",
                  "edge"
                ]
              },
              "id": {
                "type": "string"
              }
            }
          }
        }
      },
      "AssistResponse": {
        "type": "object",
        "required": [
          "mode",
          "fields",
          "source_refs",
          "suggested_edges",
          "note"
        ],
        "properties": {
          "mode": {
            "type": "string"
          },
          "fields": {
            "type": "object"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            }
          },
          "suggested_edges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "latest_version": {
            "type": "integer"
          }
        }
      }
    }
  }
}
